{
  "manifest_version": 3,
  "name": "ChatGPT Thread to Markdown",
  "version": "1.1.0",
  "description": "Exports the active ChatGPT conversation to Markdown with one click.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Export ChatGPT thread to Markdown",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
